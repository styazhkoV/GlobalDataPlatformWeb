@model GlobalDataPlatformWeb.ViewModels.SubjectRegistryViewModel
@{
    ViewData["Title"] = "Реестр субъектов (RBAC Platform)";
}

<div class="container-fluid mt-3 mb-5">
    <!-- Верхняя панель управления и переключения ролей -->
    <div class="card mb-4 border-0 shadow-sm bg-white">
        <div class="card-body p-4">
            <div class="row align-items-center g-3">
                <div class="col-lg-6">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge @Model.RoleBadgeClass px-3 py-2 fs-6 shadow-sm">
                            <i class="bi bi-shield-lock me-1"></i> @Model.RoleDisplayName
                        </span>
                        <span class="badge bg-light text-dark border">Субъектов в базе: @Model.TotalSubjectsCount</span>
                    </div>
                    <p class="text-muted small mb-0 mt-2">
                        <strong>Регламент допуска:</strong> @Model.RoleDescription
                    </p>
                </div>

                <div class="col-lg-6">
                    <form method="get" class="row g-2 justify-content-lg-end align-items-center">
                        <div class="col-auto">
                            <label class="col-form-label col-form-label-sm fw-bold text-secondary">Роль:</label>
                        </div>
                        <div class="col-auto">
                            <select name="currentRole" class="form-select form-select-sm fw-bold border-primary shadow-sm" onchange="this.form.submit()">
                                @foreach (var roleOpt in Model.AvailableRoles)
                                {
                                    if (roleOpt.IsSelected)
                                    {
                                        <option value="@roleOpt.RoleKey" selected>@roleOpt.DisplayName</option>
                                    }
                                    else
                                    {
                                        <option value="@roleOpt.RoleKey">@roleOpt.DisplayName</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-auto">
                            <input type="text" name="search" class="form-control form-control-sm" placeholder="Поиск по ФИО / ИИН..." value="@Model.SearchQuery" />
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-sm btn-outline-primary fw-semibold">
                                <i class="bi bi-search"></i> Найти
                            </button>
                            @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
                            {
                                <a asp-action="Index" asp-route-currentRole="@Model.CurrentRole" class="btn btn-sm btn-outline-secondary">Сброс</a>
                            }
                        </div>
                    </form>
                </div>
            </div>

            <!-- Архитектурная подсказка для проверяющих (Almatech) -->
            <div class="alert alert-primary-subtle border border-primary-subtle mt-3 mb-0 py-2 px-3 rounded d-flex align-items-center justify-content-between">
                <div>
                    <span class="badge bg-primary me-2">Solution Architecture</span>
                    <small class="text-dark">
                        <strong>Zero Trust &amp; DTO Projection:</strong> В Razor View полностью отсутствуют проверки названий ролей (<code>currentRole == ...</code>). 
                        Маскирование и ограничение закрытых данных осуществлено в сервисе <code>DataMaskingPolicy</code> на бэкенде.
                    </small>
                </div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-link text-decoration-none">
                    ← Резюме разработчика
                </a>
            </div>
        </div>
    </div>

    @if (!Model.Subjects.Any())
    {
        <div class="alert alert-warning text-center py-5 shadow-sm">
            <h5 class="fw-bold mb-2">Субъекты не найдены</h5>
            <p class="text-muted mb-0">По вашему поисковому запросу "<strong>@Model.SearchQuery</strong>" ничего не обнаружено.</p>
        </div>
    }

    <!-- Главный аккордеон с карточками субъектов -->
    <div class="accordion shadow-sm" id="mainSubjectsAccordion">
        @foreach (var subject in Model.Subjects)
        {
            var collapseId = "collapseSubject-" + subject.Id;
            var headingId = "headingSubject-" + subject.Id;

            <div class="accordion-item mb-3 border rounded shadow-sm overflow-hidden">
                <h2 class="accordion-header" id="@headingId">
                    <button class="accordion-button collapsed py-3" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId">
                        <span class="badge bg-secondary me-3 px-2 py-2">@subject.CitizenshipCode</span>
                        <div class="me-auto">
                            <span class="fw-bold fs-5 text-dark">@subject.FullName</span>
                            <span class="text-muted ms-2 small">(@subject.FullNameLat)</span>
                        </div>
                        <div class="me-4 text-end">
                            <span class="badge bg-light text-dark border">ИИН: @subject.NationalId</span>
                        </div>
                    </button>
                </h2>

                <div id="@collapseId" class="accordion-collapse collapse" data-bs-parent="#mainSubjectsAccordion">
                    <div class="accordion-body bg-light p-4">

                        <!-- Вложенный аккордеон по доменам данных -->
                        <div class="accordion accordion-flush bg-white rounded border shadow-sm" id="innerDomains-@subject.Id">

                            <!-- 1. Базовый профиль -->
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed fw-bold text-success" type="button" data-bs-toggle="collapse" data-bs-target="#domain-base-@subject.Id">
                                        <span class="badge bg-success me-2">1</span> Общие установочные данные (Открытый профиль)
                                    </button>
                                </h2>
                                <div id="domain-base-@subject.Id" class="accordion-collapse collapse show">
                                    <div class="accordion-body">
                                        <div class="row g-3">
                                            <div class="col-md-3">
                                                <small class="text-muted d-block">ФИО (латиница):</small>
                                                <strong>@subject.FullNameLat</strong>
                                            </div>
                                            <div class="col-md-3">
                                                <small class="text-muted d-block">Дата рождения:</small>
                                                <strong>@subject.DateOfBirth.ToString("dd.MM.yyyy")</strong>
                                            </div>
                                            <div class="col-md-3">
                                                <small class="text-muted d-block">Пол:</small>
                                                <strong>@subject.Gender</strong>
                                            </div>
                                            <div class="col-md-3">
                                                <small class="text-muted d-block">Семейное положение:</small>
                                                <strong>@subject.CivilStatus</strong>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- 2. Паспортные данные -->
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed fw-bold text-info" type="button" data-bs-toggle="collapse" data-bs-target="#domain-pass-@subject.Id">
                                        <span class="badge bg-info text-dark me-2">2</span> Документы и Паспортные данные
                                    </button>
                                </h2>
                                <div id="domain-pass-@subject.Id" class="accordion-collapse collapse">
                                    <div class="accordion-body">
                                        @if (subject.Passport.IsRestricted)
                                        {
                                            <div class="alert alert-secondary mb-0">
                                                <strong>Доступ заблокирован:</strong> @subject.Passport.AccessNotice
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="row g-3">
                                                <div class="col-md-4">
                                                    <small class="text-muted d-block">Номер паспорта:</small>
                                                    <span class="fw-bold @(subject.Passport.IsMasked ? "text-warning" : "text-dark")">
                                                        @subject.Passport.DisplayPassportNumber
                                                    </span>
                                                </div>
                                                <div class="col-md-4">
                                                    <small class="text-muted d-block">Орган выдачи:</small>
                                                    <span>@subject.Passport.IssuingAuthority</span>
                                                </div>
                                                <div class="col-md-4">
                                                    <small class="text-muted d-block">Срок действия:</small>
                                                    <span>@subject.Passport.ExpiryDate?.ToString("dd.MM.yyyy")</span>
                                                </div>
                                                <div class="col-md-12">
                                                    <small class="text-muted d-block">Адрес регистрации:</small>
                                                    <span>@subject.Passport.RegistrationAddress</span>
                                                </div>
                                            </div>

                                            @if (subject.Passport.IsGranted)
                                            {
                                                <div class="alert alert-dark mt-3 mb-0 py-2">
                                                    <small>
                                                        <strong>MRZ:</strong> <code>@subject.Passport.MachineReadableZone</code> | 
                                                        <strong>Biometric Hash:</strong> <code>@subject.Passport.BiometricHash</code>
                                                    </small>
                                                </div>
                                            }
                                            else if (subject.Passport.IsMasked)
                                            {
                                                <div class="alert alert-warning mt-3 mb-0 py-2">
                                                    <small>
                                                        <strong>Режим маскирования:</strong> @subject.Passport.AccessNotice
                                                    </small>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- 3. Финансы и Валютные контракты -->
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed fw-bold text-primary" type="button" data-bs-toggle="collapse" data-bs-target="#domain-fin-@subject.Id">
                                        <span class="badge bg-primary me-2">3</span> Финансовый профиль и ВЭД Контракты
                                    </button>
                                </h2>
                                <div id="domain-fin-@subject.Id" class="accordion-collapse collapse">
                                    <div class="accordion-body">
                                        @if (subject.Finance.IsGranted)
                                        {
                                            <div class="row g-3 mb-3">
                                                <div class="col-md-4">
                                                    <small class="text-muted d-block">Годовой доход:</small>
                                                    <span class="text-success fw-bold fs-5">$@subject.Finance.TotalAnnualIncome?.ToString("N2")</span>
                                                </div>
                                                <div class="col-md-4">
                                                    <small class="text-muted d-block">Заявленные активы:</small>
                                                    <span class="fw-bold fs-5">$@subject.Finance.DeclaredAssetsValue?.ToString("N2")</span>
                                                </div>
                                                <div class="col-md-4">
                                                    <small class="text-muted d-block">AML Риск-скоринг:</small>
                                                    <span class="badge @(subject.Finance.AmlRiskScore == "Critical" || subject.Finance.AmlRiskScore == "High" ? "bg-danger" : "bg-warning text-dark") fs-6">
                                                        @subject.Finance.AmlRiskScore
                                                    </span>
                                                </div>
                                            </div>

                                            <h6 class="fw-bold mt-4 mb-2 text-secondary">Реестр валютных контрактов ВЭД (1:N):</h6>
                                            <div class="table-responsive">
                                                <table class="table table-sm table-hover table-bordered mb-0 align-middle">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th>УНК</th>
                                                            <th>Тип контракта</th>
                                                            <th>Сумма</th>
                                                            <th>Контрагент</th>
                                                            <th>Страна</th>
                                                            <th>Категория риска</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var contract in subject.Finance.Contracts)
                                                        {
                                                            <tr>
                                                                <td><code>@contract.UniqueContractNumber</code></td>
                                                                <td>@contract.ContractType</td>
                                                                <td><strong>@contract.TotalAmount.ToString("N2") @contract.CurrencyCode</strong></td>
                                                                <td>@contract.ForeignCounterpartyName</td>
                                                                <td><span class="badge bg-light text-dark border">@contract.ForeignCounterpartyCountry</span></td>
                                                                <td>
                                                                    <span class="badge @(contract.RiskCategory == "High Risk" ? "bg-danger" : "bg-warning text-dark")">
                                                                        @contract.RiskCategory
                                                                    </span>
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="alert alert-danger mb-0">
                                                <strong>Доступ ограничен:</strong> @subject.Finance.AccessNotice
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- 4. Спецслужбы / КНБ -->
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed fw-bold text-danger" type="button" data-bs-toggle="collapse" data-bs-target="#domain-sec-@subject.Id">
                                        <span class="badge bg-danger me-2">4</span> Служебное досье КНБ
                                    </button>
                                </h2>
                                <div id="domain-sec-@subject.Id" class="accordion-collapse collapse">
                                    <div class="accordion-body">
                                        @if (subject.Security.IsGranted)
                                        {
                                            <div class="row g-3">
                                                <div class="col-md-3">
                                                    <small class="text-muted d-block">Уровень допуска:</small>
                                                    <span class="badge bg-dark fs-6">@subject.Security.ClearanceLevel</span>
                                                </div>
                                                <div class="col-md-3">
                                                    <small class="text-muted d-block">PEP Статус:</small>
                                                    <span class="fw-semibold">@subject.Security.PepStatus</span>
                                                </div>
                                                <div class="col-md-3">
                                                    <small class="text-muted d-block">Судимость:</small>
                                                    <span class="fw-semibold">@subject.Security.CriminalRecord</span>
                                                </div>
                                                <div class="col-md-3">
                                                    <small class="text-muted d-block">Спецучет / Watchlist:</small>
                                                    <span class="badge @(subject.Security.IsOnWatchlist == true ? "bg-danger" : "bg-success")">
                                                        @(subject.Security.IsOnWatchlist == true ? "Состоит на спецучете" : "Чист")
                                                    </span>
                                                </div>
                                            </div>

                                            <div class="mt-3">
                                                <small class="fw-bold text-secondary">История пересечения государственной границы:</small>
                                                <div class="bg-dark text-success p-2 rounded mt-1 font-monospace small">
                                                    @if (subject.Security.BorderCrossings.Any())
                                                    {
                                                        <ul class="list-unstyled mb-0">
                                                            @foreach (var log in subject.Security.BorderCrossings)
                                                            {
                                                                <li><i class="bi bi-airplane me-1"></i> @log</li>
                                                            }
                                                        </ul>
                                                    }
                                                    else
                                                    {
                                                        <span>Записи о пересечении границы отсутствуют.</span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="alert alert-danger mb-0">
                                                <strong>Совершенно секретно:</strong> @subject.Security.AccessNotice
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- 5. Агропромышленный комплекс -->
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed fw-bold text-dark" type="button" data-bs-toggle="collapse" data-bs-target="#domain-agro-@subject.Id">
                                        <span class="badge bg-success me-2">5</span> Реестр Агропромышленного комплекса (АПК)
                                    </button>
                                </h2>
                                <div id="domain-agro-@subject.Id" class="accordion-collapse collapse">
                                    <div class="accordion-body">
                                        @if (subject.Agro.IsGranted)
                                        {
                                            <div class="row g-3">
                                                <div class="col-md-4">
                                                    <small class="text-muted d-block">Земельный фонд:</small>
                                                    <strong class="fs-5">@subject.Agro.TotalLandAreaHectares га</strong>
                                                </div>
                                                <div class="col-md-4">
                                                    <small class="text-muted d-block">Экспортные квоты:</small>
                                                    <span class="badge @(subject.Agro.HasActiveExportQuotas == true ? "bg-success" : "bg-secondary") fs-6">
                                                        @(subject.Agro.HasActiveExportQuotas == true ? "Активны" : "Отсутствуют")
                                                    </span>
                                                </div>
                                                <div class="col-md-12">
                                                    <small class="text-muted d-block">Кадастровые участки:</small>
                                                    <div class="d-flex gap-2 flex-wrap mt-1">
                                                        @foreach (var plot in subject.Agro.CadastralPlots)
                                                        {
                                                            <span class="badge bg-light text-dark border font-monospace">@plot</span>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="col-md-12">
                                                    <small class="text-muted d-block">Поголовье скота:</small>
                                                    <div class="d-flex gap-3 flex-wrap mt-1">
                                                        @foreach (var item in subject.Agro.LivestockCount)
                                                        {
                                                            <div class="border rounded px-3 py-1 bg-light">
                                                                <small class="text-muted">@item.Key:</small>
                                                                <strong>@item.Value голов</strong>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="alert alert-secondary mb-0">
                                                <strong>Доступ ограничен:</strong> @subject.Agro.AccessNotice
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                        </div> <!-- /innerDomains -->

                    </div>
                </div>
            </div>
        }
    </div>
</div>