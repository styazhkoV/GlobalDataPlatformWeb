<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GlobalDataPlatform</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GlobalDataPlatformWeb.styles.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom border-primary border-3 shadow-sm py-2">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span class="badge bg-primary px-2 py-1"><i class="bi bi-diagram-3-fill"></i></span>
                    <span>GlobalDataPlatform</span>
                    <span class="badge bg-secondary font-monospace fs-7 text-uppercase">MVP</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain"
                        aria-expanded="false" aria-label="Переключить навигацию">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-white-50 active" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-person-badge"></i> Визитка / Резюме
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50" asp-controller="Subjects" asp-action="Index">
                                <i class="bi bi-shield-shaded"></i> Реестр субъектов (RBAC)
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-3">
                        <span class="text-white-50 small d-none d-md-inline">
                            Разработчик: <strong>Александр Стяжков</strong> (Senior SA / Tech Lead)
                        </span>
                        <a asp-controller="Subjects" asp-action="Index" class="btn btn-sm btn-outline-info">
                            <i class="bi bi-play-circle-fill me-1"></i> Демо матрицы
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4 flex-grow-1">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer bg-white py-3 mt-auto">
        <div class="container-fluid px-4 d-flex flex-wrap justify-content-between align-items-center small text-muted">
            <div>
                &copy; 2026 <strong>GlobalDataPlatformWeb</strong> — Демонстрационный проект для команды <strong>Almatech</strong>.
            </div>
            <div>
                Стек: <span class="badge bg-light text-dark border">ASP.NET Core 8 MVC</span>
                <span class="badge bg-light text-dark border">EF Core SQLite</span>
                <span class="badge bg-light text-dark border">Zero Trust RBAC</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
